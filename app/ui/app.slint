import { Theme, ThemeMode } from "theme.slint";
// Barlow (SIL OFL 1.1, see fonts/OFL.txt), embedded so the app looks the same on every PC.
import "fonts/Barlow-Regular.ttf";
import "fonts/Barlow-SemiBold.ttf";
import "fonts/BarlowSemiCondensed-SemiBold.ttf";
import { Avatar, Button, GameTile, IconButton, Segmented, StatusCard, Swatch, Toast, Toggle } from "components.slint";

export { Theme, ThemeMode }

export enum GameKind { valorant, league }

export struct RankView {
    known: bool,
    tier: string,
    points: string,
    level: int,
    // "hace 3 min": when the rank was read from the game.
    updated: string,
}

export struct AccountView {
    initials: string,
    name: string,
    tag: string,
    region: string,
    has-valorant: bool,
    has-league: bool,
    valorant: RankView,
    league: RankView,
    // "hace 3 h"; empty when never used.
    last-used: string,
    active: bool,
    // Name chosen by the user (empty when none); `name`/`tag` are then shown smaller.
    alias: string,
}

component Label inherits Text {
    color: Theme.muted;
    font-size: 12px;
}

// A row of the account menu.
component AccountMenuRow inherits Rectangle {
    in property <image> icon;
    // Game logos keep their own colours; line icons take the row's colour.
    in property <bool> tint-icon: true;
    in property <string> text;
    in property <color> tone: Theme.text;
    // Shows a checkbox at the end of the row.
    in property <bool> checkable;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked;

    height: 32px;
    border-radius: 7px;
    background: touch.has-hover && enabled ? (tone == Theme.danger ? Theme.danger.with-alpha(0.12) : Theme.hover) : transparent;
    opacity: enabled ? 1 : 0.5;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.tint-icon ? root.tone : transparent;
                width: 16px;
                height: 16px;
            }
        }
        Text {
            text: root.text;
            color: root.tone;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.checkable: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 4px;
                border-width: root.checked ? 0 : 1px;
                border-color: Theme.muted;
                background: root.checked ? Theme.accent : transparent;
                if root.checked: Image {
                    source: @image-url("icons/check.svg");
                    colorize: Theme.on-accent;
                    width: 12px;
                    height: 12px;
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

component AccountMenuGap inherits Rectangle {
    height: 9px;
    Rectangle {
        y: 4px;
        height: 1px;
        background: Theme.border;
    }
}

// One of the stacked content panels; fades and slides a little when it shows or hides.
component Panel inherits Rectangle {
    in property <bool> shown;
    in property <length> offset: 12px;

    opacity: shown ? 1 : 0;
    x: shown ? 0 : offset;
    visible: self.opacity > 0.01;
    animate opacity, x { duration: 180ms; easing: ease-out; }
}

export component AppWindow inherits Window {
    title: "ALTR";
    icon: @image-url("icons/altr.svg");
    preferred-width: 720px;
    preferred-height: 440px;
    min-width: 600px;
    min-height: 400px;
    background: Theme.bg;
    default-font-family: "Barlow";
    default-font-size: 13px;

    in property <[AccountView]> accounts;
    in property <string> version;
    // Official icons from the Riot install; empty images fall back to a letter.
    in property <image> valorant-icon;
    in property <image> league-icon;
    in-out property <int> selected: 0;
    in-out property <GameKind> game: GameKind.valorant;
    in-out property <GameKind> default-game: GameKind.valorant;
    in-out property <bool> settings-open;
    // A background action is running; its step is shown in the bottom bar.
    in property <bool> busy;
    in property <string> progress;
    // Second line of the progress card (e.g. "3,2 de 5,1 GB · 12 MB/s").
    in property <string> progress-detail;
    // 0–1 while the step has measurable progress (game updates), negative otherwise.
    in property <float> progress-fraction: -1;
    // The running action may update `updating-game` (an update, or "Jugar" on an outdated game).
    in property <bool> updating;
    in property <GameKind> updating-game;
    // The game opens by itself when the running update finishes.
    in property <bool> play-after;
    // The running action is "Jugar": opening a game shows as a spinner in the button.
    in property <bool> launching;
    // Games that are open right now (checked every 2 s).
    in property <bool> valorant-running;
    in property <bool> league-running;
    // A game update is waiting.
    in property <bool> valorant-update;
    in property <bool> league-update;
    in property <bool> can-cancel;
    // A newer ALTR release, e.g. "0.2.0"; empty when up to date or not installed via the Setup.
    in property <string> app-update;
    // Result of the last action, shown as a toast.
    in property <string> toast-text;
    in property <bool> toast-error;
    in-out property <bool> toast-visible;
    in-out property <bool> confirm-switch: true;
    // Account waiting for confirmation in the dialog, -1 when closed.
    in-out property <int> pending: -1;
    // The dialog asks to remove `pending` instead of switching to it.
    in-out property <bool> pending-remove;

    // Closing the window keeps ALTR in the system tray.
    in-out property <bool> tray-enabled: true;
    // Account being renamed in the dialog, -1 when closed.
    in-out property <int> renaming: -1;
    // Sidebar drag: the account being dragged and where it would land (-1 when not dragging).
    in-out property <int> drag-from: -1;
    in-out property <int> drag-to: -1;
    // How far the dragged avatar has moved from its slot.
    property <length> drag-dy;

    callback play(GameKind);
    callback update(GameKind);
    callback queue-play();
    callback switch-account(int);
    callback remove-account(int);
    callback rename-account(int, string);
    callback set-plays(int, GameKind, bool);
    callback move-account(int, int);
    callback add-account();
    callback cancel();
    callback install-app-update();
    callback settings-changed();

    // What the big button (and Enter) does right now.
    public function main-action() {
        if (selected-updating) {
            queue-play();
        } else if (busy || game-running || accounts.length == 0) {
            return;
        } else if (needs-update) {
            update(game);
        } else {
            play(game);
        }
    }

    // Closes any dialog and gives the keyboard back to the shortcuts.
    function close-dialogs() {
        pending = -1;
        renaming = -1;
        keys.focus();
    }

    public function request-switch(i: int) {
        if (busy || i < 0 || i >= accounts.length) {
            return;
        }
        settings-open = false;
        if (accounts[i].active) {
            select(i);
        } else if (confirm-switch) {
            pending-remove = false;
            pending = i;
        } else {
            select(i);
            switch-account(i);
        }
    }

    function request-remove(i: int) {
        if (!busy) {
            pending-remove = true;
            pending = i;
        }
    }

    function confirm-pending() {
        if (pending-remove) {
            remove-account(pending);
        } else {
            // Show the target while it switches; a failure re-selects the active account.
            select(pending);
            switch-account(pending);
        }
        close-dialogs();
    }

    property <AccountView> current: accounts[selected];
    property <bool> is-valorant: game == GameKind.valorant;
    property <RankView> rank: is-valorant ? current.valorant : current.league;
    property <bool> needs-update: is-valorant ? valorant-update : league-update;
    // The selected game is the one being updated right now.
    property <bool> selected-updating: busy && updating && updating-game == game && progress-fraction >= 0;
    // Opening a game (not updating it first): shown inside the Play button.
    property <bool> opening: busy && launching && progress-fraction < 0;
    // A running action the status card should show.
    property <bool> task-card: busy && progress != "" && !opening;
    property <bool> game-running: is-valorant ? valorant-running : league-running;

    // Ring progress for a game tile: shown only while that game updates and isn't selected.
    pure function ring(g: GameKind) -> float {
        return busy && updating && updating-game == g && game != g ? progress-fraction : -1;
    }

    // Game-specific content fades out, the game changes, then it fades back in.
    property <GameKind> next-game;
    property <bool> fading;
    public function show-game(g: GameKind) {
        next-game = g;
        fading = true;
    }
    Timer {
        interval: 150ms;
        running: root.fading;
        triggered => {
            root.game = root.next-game;
            root.fading = false;
        }
    }

    // Shows the account's default game when it has it, otherwise the one it does have.
    public function select(i: int) {
        selected = i;
        if (default-game == GameKind.valorant) {
            show-game(accounts[i].has-valorant ? GameKind.valorant : GameKind.league);
        } else {
            show-game(accounts[i].has-league ? GameKind.league : GameKind.valorant);
        }
    }

    animate background { duration: 150ms; }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && !event.modifiers.alt && event.text.character-count == 1 && event.text.is-float() && event.text != "0") {
                root.request-switch(event.text.to-float() - 1);
                return accept;
            }
            if (event.text == Key.Return && !root.settings-open) {
                root.main-action();
                return accept;
            }
            if (event.text == Key.Escape && root.settings-open) {
                root.settings-open = false;
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        Rectangle {
            width: 68px;
            background: Theme.sidebar;
            animate background { duration: 150ms; }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.border;
            }

            // Selection ring: slides to the selected avatar (avatars sit every 56px from y = 18px).
            Rectangle {
                x: 10px;
                y: 14px + root.selected * 56px;
                width: 48px;
                height: 48px;
                border-radius: 15px;
                border-width: 2px;
                border-color: Theme.accent;
                opacity: root.settings-open || root.accounts.length == 0 || root.drag-from >= 0 ? 0 : 1;
                animate y { duration: 220ms; easing: ease-out; }
                animate opacity { duration: 150ms; }
            }

            // Where the dragged account will land.
            if root.drag-from >= 0: Rectangle {
                x: 10px;
                y: 14px + root.drag-to * 56px;
                width: 48px;
                height: 48px;
                border-radius: 15px;
                background: Theme.accent.with-alpha(0.18);
                animate y { duration: 150ms; easing: ease-out; }
            }

            VerticalLayout {
                padding: 14px;
                padding-top: 18px;
                spacing: 16px;

                for acc[i] in root.accounts: Rectangle {
                    width: 40px;
                    height: 40px;
                    // The dragged avatar is drawn above the others.
                    z: i == root.drag-from ? 1 : 0;

                    // Avatars between the dragged one and its target make room for it.
                    Rectangle {
                        y: root.drag-from < 0 || i == root.drag-from ? 0
                            : root.drag-from < i && i <= root.drag-to ? -56px
                            : root.drag-to <= i && i < root.drag-from ? 56px : 0;
                        animate y { duration: 150ms; easing: ease-out; }

                        Avatar {
                            y: i == root.drag-from ? root.drag-dy : 0;
                            opacity: i == root.drag-from ? 0.85 : 1;
                            initials: acc.initials;
                            badge: acc.has-valorant && acc.has-league ? "V·L" : acc.has-valorant ? "V" : "L";
                            selected: i == root.selected && !root.settings-open;
                            clicked => { root.request-switch(i); }
                            context-menu => {
                                if (!root.busy) {
                                    menu.show();
                                }
                            }
                            drag-moved(d) => {
                                if (root.busy || root.accounts.length < 2) {
                                    return;
                                }
                                root.drag-from = i;
                                root.drag-dy += d;
                                root.drag-to = max(0, min(root.accounts.length - 1, i + round(root.drag-dy / 56px)));
                            }
                            drag-ended => {
                                if (root.drag-from == i && root.drag-to != i) {
                                    root.move-account(i, root.drag-to);
                                }
                                root.drag-from = -1;
                                root.drag-to = -1;
                                root.drag-dy = 0;
                            }
                        }
                    }

                    menu := PopupWindow {
                        x: 48px;
                        width: 208px;
                        height: items.preferred-height;

                        Rectangle {
                            property <bool> shown;
                            init => { self.shown = true; }
                            opacity: self.shown ? 1 : 0;
                            animate opacity { duration: 120ms; }
                            border-radius: 10px;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.border;

                            items := VerticalLayout {
                                padding: 4px;
                                AccountMenuRow {
                                    icon: @image-url("icons/pencil.svg");
                                    text: "Cambiar nombre";
                                    clicked => { root.renaming = i; }
                                }
                                AccountMenuGap { }
                                // A saved account plays at least one game: the last one can't be unticked.
                                AccountMenuRow {
                                    icon: root.valorant-icon;
                                    tint-icon: false;
                                    text: "Valorant";
                                    checkable: true;
                                    checked: acc.has-valorant;
                                    enabled: !acc.has-valorant || acc.has-league;
                                    clicked => { root.set-plays(i, GameKind.valorant, !acc.has-valorant); }
                                }
                                AccountMenuRow {
                                    icon: root.league-icon;
                                    tint-icon: false;
                                    text: "League of Legends";
                                    checkable: true;
                                    checked: acc.has-league;
                                    enabled: !acc.has-league || acc.has-valorant;
                                    clicked => { root.set-plays(i, GameKind.league, !acc.has-league); }
                                }
                                AccountMenuGap { }
                                AccountMenuRow {
                                    icon: @image-url("icons/trash.svg");
                                    text: "Eliminar cuenta";
                                    tone: Theme.danger;
                                    clicked => { root.request-remove(i); }
                                }
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                IconButton {
                    icon: @image-url("icons/plus.svg");
                    clicked => {
                        if (!root.busy) {
                            root.add-account();
                        }
                    }
                }
                IconButton {
                    icon: @image-url("icons/settings.svg");
                    active: root.settings-open;
                    clicked => { root.settings-open = !root.settings-open; }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;

            Panel {
                shown: root.settings-open;

                VerticalLayout {
                    padding: 24px;
                    // Fits the 400 px minimum height.
                    spacing: 14px;

                    Text {
                        text: "Ajustes";
                        color: Theme.text;
                        font-size: 22px;
                        font-weight: 600;
                    }

                    VerticalLayout {
                        spacing: 8px;
                        Label { text: "Tema"; }
                        // A fixed-width child would cap the layout's max width and shrink the window.
                        Rectangle {
                            height: 32px;
                            Segmented {
                                x: 0;
                                width: 300px;
                                items: ["Sistema", "Claro", "Oscuro"];
                                current: Theme.mode == ThemeMode.system ? 0 : Theme.mode == ThemeMode.light ? 1 : 2;
                                changed(i) => {
                                    Theme.mode = i == 0 ? ThemeMode.system : i == 1 ? ThemeMode.light : ThemeMode.dark;
                                    root.settings-changed();
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        Label { text: "Color de acento"; }
                        HorizontalLayout {
                            padding-top: 4px;
                            spacing: 6px;
                            for c[i] in Theme.accents: VerticalLayout {
                                width: 56px;
                                spacing: 8px;
                                HorizontalLayout {
                                    alignment: center;
                                    Swatch {
                                        swatch: c;
                                        selected: i == Theme.accent-index;
                                        clicked => {
                                            Theme.accent-index = i;
                                            root.settings-changed();
                                        }
                                    }
                                }
                                Text {
                                    text: Theme.accent-names[i];
                                    color: i == Theme.accent-index ? Theme.text : Theme.muted;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                            }
                            // Unbounded filler so the fixed-width columns don't cap the window width.
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        Label { text: "Juego por defecto"; }
                        Rectangle {
                            height: 32px;
                            Segmented {
                                x: 0;
                                width: 300px;
                                items: ["Valorant", "League of Legends"];
                                current: root.default-game == GameKind.valorant ? 0 : 1;
                                changed(i) => {
                                    root.default-game = i == 0 ? GameKind.valorant : GameKind.league;
                                    root.settings-changed();
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            alignment: start;
                            spacing: 10px;
                            Toggle {
                                checked: root.confirm-switch;
                                toggled => {
                                    root.confirm-switch = !root.confirm-switch;
                                    root.settings-changed();
                                }
                            }
                            Text {
                                text: "Pedir confirmación antes de cambiar de cuenta";
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 10px;
                            Toggle {
                                checked: root.tray-enabled;
                                toggled => {
                                    root.tray-enabled = !root.tray-enabled;
                                    root.settings-changed();
                                }
                            }
                            Text {
                                text: "Al cerrar la ventana, seguir en la bandeja del sistema";
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        spacing: 12px;
                        Label {
                            text: "Ctrl+1…9 cambia de cuenta · Intro juega · Esc cierra Ajustes";
                            font-size: 11px;
                            horizontal-stretch: 1;
                        }
                        Label {
                            text: "ALTR " + root.version;
                            font-size: 11px;
                        }
                    }
                }
            }

            Panel {
                shown: !root.settings-open && root.accounts.length == 0;
                offset: -12px;

                VerticalLayout {
                    alignment: center;
                    spacing: 14px;

                    Text {
                        text: "Añade tu primera cuenta";
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Label {
                        text: "Inicia sesión una vez y cambia de cuenta con un clic.";
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                    // Elastic spacers instead of `alignment: center`: a fixed-width child would cap the window width.
                    HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                        if !root.busy: Button {
                            primary: true;
                            icon: @image-url("icons/plus.svg");
                            text: "Añadir cuenta";
                            clicked => { root.add-account(); }
                        }
                        if root.busy: StatusCard {
                            width: 400px;
                            title: root.progress;
                            detail: root.progress-detail;
                            spinning: true;
                            action: root.can-cancel ? "Cancelar" : "";
                            act => { root.cancel(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }

            Panel {
                shown: !root.settings-open && root.accounts.length > 0;
                offset: -12px;

                VerticalLayout {
                    padding: 24px;
                    spacing: 18px;

                    HorizontalLayout {
                        spacing: 12px;

                        VerticalLayout {
                            spacing: 4px;
                            alignment: start;
                            HorizontalLayout {
                                alignment: start;
                                Text {
                                    text: root.current.alias != "" ? root.current.alias : root.current.name;
                                    color: Theme.text;
                                    font-size: 22px;
                                    font-weight: 600;
                                }
                                if root.current.alias == "": Text {
                                    text: "#" + root.current.tag;
                                    color: Theme.muted;
                                    font-size: 22px;
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 6px;
                                if root.current.active: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 7px;
                                        height: 7px;
                                        border-radius: 3.5px;
                                        background: Theme.success;
                                    }
                                }
                                Label {
                                    text: (root.current.active ? "Conectada" : root.current.last-used == "" ? "Sin usar" : "Usada " + root.current.last-used)
                                        + (root.current.region == "" ? "" : " · " + root.current.region)
                                        + (root.current.alias == "" ? "" : " · " + root.current.name + "#" + root.current.tag);
                                }
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        VerticalLayout {
                            alignment: start;
                            padding-top: 2px;
                            HorizontalLayout {
                                spacing: 12px;
                                GameTile {
                                    icon: root.valorant-icon;
                                    fallback: "V";
                                    selected: root.next-game == GameKind.valorant;
                                    badge: root.valorant-update;
                                    progress: root.ring(GameKind.valorant);
                                    clicked => { root.show-game(GameKind.valorant); }
                                }
                                GameTile {
                                    icon: root.league-icon;
                                    fallback: "L";
                                    selected: root.next-game == GameKind.league;
                                    badge: root.league-update;
                                    progress: root.ring(GameKind.league);
                                    clicked => { root.show-game(GameKind.league); }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 84px;
                        border-radius: 10px;
                        background: Theme.card;
                        border-width: 1px;
                        border-color: Theme.border;
                        opacity: root.fading ? 0 : 1;
                        animate opacity { duration: 150ms; }

                        HorizontalLayout {
                            padding: 16px;
                            spacing: 14px;

                            Rectangle {
                                width: 52px;
                                height: 52px;
                                border-radius: 12px;
                                background: Theme.accent-soft;
                                Image {
                                    source: @image-url("icons/trophy.svg");
                                    colorize: Theme.accent;
                                    width: 24px;
                                    height: 24px;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Label {
                                    text: (root.is-valorant ? "Rango competitivo" : "Clasificatoria solo/dúo")
                                        + (root.rank.known && root.rank.updated != "" ? " · " + root.rank.updated : "");
                                }
                                Text {
                                    text: !root.rank.known ? "Sin datos todavía" : root.rank.points == "" ? root.rank.tier : root.rank.tier + " · " + root.rank.points;
                                    color: Theme.text;
                                    font-size: 18px;
                                    font-weight: 600;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Label {
                                    text: "Nivel";
                                    horizontal-alignment: right;
                                }
                                Text {
                                    text: root.rank.known ? "\{root.rank.level}" : "—";
                                    color: Theme.text;
                                    font-size: 18px;
                                    font-weight: 600;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        spacing: 16px;

                        // The running action, whatever game it concerns. Opening a game shows in the button instead.
                        if root.task-card: StatusCard {
                            horizontal-stretch: 1;
                            title: root.progress;
                            detail: root.progress-detail;
                            spinning: root.progress-fraction < 0;
                            icon: @image-url("icons/download.svg");
                            progress: root.progress-fraction;
                            action: root.can-cancel ? "Cancelar" : "";
                            act => { root.cancel(); }
                        }
                        if !root.busy && root.needs-update: StatusCard {
                            horizontal-stretch: 1;
                            title: "Actualización de " + (root.is-valorant ? "Valorant" : "League of Legends");
                            detail: "Pulsa ACTUALIZAR para descargarla";
                            icon: @image-url("icons/download.svg");
                        }
                        if !root.busy && !root.needs-update && root.app-update != "": StatusCard {
                            horizontal-stretch: 1;
                            tone: Theme.success;
                            title: "Nueva versión " + root.app-update;
                            detail: "Se instala en segundos";
                            icon: @image-url("icons/download.svg");
                            action: "Actualizar";
                            action-primary: true;
                            act => { root.install-app-update(); }
                        }
                        if !root.task-card && (root.busy || (!root.needs-update && root.app-update == "")): Rectangle {
                            horizontal-stretch: 1;
                        }

                        // Hidden while another action runs; stays to show "opening" and to queue
                        // "play" during the selected game's update.
                        if !root.busy || root.selected-updating || root.opening: Rectangle {
                            width: 190px;
                            height: 40px;
                            opacity: root.fading ? 0 : 1;
                            animate opacity { duration: 150ms; }
                            Button {
                                width: parent.width;
                                primary: !root.selected-updating && !(root.game-running && !root.busy);
                                emphasis: true;
                                loading: root.opening;
                                icon: root.selected-updating
                                    ? (root.play-after ? @image-url("icons/check.svg") : @image-url("icons/clock.svg"))
                                    : root.game-running ? @image-url("icons/check.svg")
                                    : root.needs-update ? @image-url("icons/download.svg") : @image-url("icons/play.svg");
                                // While its own update runs the button stays usable to queue "play";
                                // a game that is already open can't be started twice.
                                enabled: root.selected-updating || (!root.busy && !root.game-running);
                                text: root.opening ? "Abriendo…"
                                    : root.selected-updating ? (root.play-after ? "Se abrirá al terminar" : "Jugar al terminar")
                                    : root.game-running ? "Abierto"
                                    : root.needs-update ? "Actualizar" : "Jugar";
                                clicked => { root.main-action(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // Above the bottom bar, centred in the content area.
    Toast {
        x: 68px + (root.width - 68px - self.width) / 2;
        y: root.height - 24px - 40px - 14px - self.height + (root.toast-visible ? 0 : 6px);
        animate y { duration: 180ms; }
        text: root.toast-text;
        error: root.toast-error;
        shown: root.toast-visible;
        dismiss => { root.toast-visible = false; }
    }

    if root.pending >= 0: Rectangle {
        property <AccountView> target: root.accounts[root.pending];
        property <bool> shown;
        init => { self.shown = true; }
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 150ms; }
        background: Theme.dark ? #000000A0 : #00000059;

        // Clicking outside the card cancels.
        TouchArea {
            clicked => { root.close-dialogs(); }
        }

        // The account menu hands the focus back when it closes, after this dialog
        // appears; take it once that has happened.
        Timer {
            interval: 1ms;
            running: !confirm-keys.has-focus;
            triggered => { confirm-keys.focus(); }
        }

        confirm-keys := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close-dialogs();
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.confirm-pending();
                    return accept;
                }
                reject
            }
        }

        Rectangle {
            width: 360px;
            height: card.preferred-height;
            border-radius: 12px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;

            // Swallow clicks on the card so they don't cancel.
            TouchArea { }

            card := VerticalLayout {
                padding: 20px;
                spacing: 18px;

                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        alignment: start;
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 12px;
                            background: root.pending-remove ? Theme.danger.with-alpha(0.15) : Theme.accent-soft;
                            Text {
                                text: target.initials;
                                color: root.pending-remove ? Theme.danger : Theme.accent;
                                font-size: 15px;
                                font-weight: 600;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text {
                            text: (root.pending-remove ? "¿Eliminar " : "¿Cambiar a ") + (target.alias != "" ? target.alias : target.name + "#" + target.tag) + "?";
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Label {
                            text: root.pending-remove
                                ? "Se borrará su sesión guardada. Podrás volver a añadirla iniciando sesión."
                                : "Se cerrará el Riot Client y se volverá a abrir con esta cuenta.";
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancelar";
                        clicked => { root.close-dialogs(); }
                    }
                    Button {
                        primary: true;
                        danger: root.pending-remove;
                        text: root.pending-remove ? "Eliminar" : "Cambiar";
                        clicked => { root.confirm-pending(); }
                    }
                }
            }
        }
    }

    if root.renaming >= 0: Rectangle {
        property <AccountView> target: root.accounts[root.renaming];
        property <bool> shown;
        init => { self.shown = true; }
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 150ms; }
        background: Theme.dark ? #000000A0 : #00000059;

        function save() {
            root.rename-account(root.renaming, field.text);
            root.close-dialogs();
        }

        // See the confirmation dialog: the closing menu takes the focus back first.
        Timer {
            interval: 1ms;
            running: !field.has-focus;
            triggered => { field.focus(); }
        }

        TouchArea {
            clicked => { root.close-dialogs(); }
        }

        Rectangle {
            width: 360px;
            height: form.preferred-height;
            border-radius: 12px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea { }

            form := VerticalLayout {
                padding: 20px;
                spacing: 14px;

                Text {
                    text: "Cambiar nombre";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 600;
                }
                Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: Theme.bg;
                    border-width: 1px;
                    border-color: field.has-focus ? Theme.accent : Theme.border;
                    animate border-color { duration: 120ms; }

                    field := TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        text: target.alias != "" ? target.alias : target.name;
                        color: Theme.text;
                        selection-background-color: Theme.accent.with-alpha(0.35);
                        font-size: 14px;
                        vertical-alignment: center;
                        single-line: true;
                        init => { self.select-all(); }
                        accepted => { save(); }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.close-dialogs();
                                return accept;
                            }
                            reject
                        }
                    }
                }
                Label {
                    text: "Solo se ve en ALTR. Déjalo vacío para usar " + target.name + "#" + target.tag + ".";
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancelar";
                        clicked => { root.close-dialogs(); }
                    }
                    Button {
                        primary: true;
                        text: "Guardar";
                        clicked => { save(); }
                    }
                }
            }
        }
    }
}

// Icon in the notification area: ALTR keeps running there when its window is closed.
export component Tray inherits SystemTrayIcon {
    icon: @image-url("icons/altr.svg");
    tooltip: "ALTR";
    in property <[AccountView]> accounts;
    in property <image> valorant-icon;
    in property <image> league-icon;
    callback switch-account(int);
    callback play(GameKind);
    callback open();
    callback quit();

    clicked => { root.open(); }

    Menu {
        for acc[i] in root.accounts: MenuItem {
            title: (acc.active ? "✓ " : "    ") + (acc.alias != "" ? acc.alias : acc.name + "#" + acc.tag);
            activated => { root.switch-account(i); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Jugar Valorant";
            icon: root.valorant-icon;
            activated => { root.play(GameKind.valorant); }
        }
        MenuItem {
            title: "Jugar League of Legends";
            icon: root.league-icon;
            activated => { root.play(GameKind.league); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Abrir ALTR";
            activated => { root.open(); }
        }
        MenuItem {
            title: "Salir";
            activated => { root.quit(); }
        }
    }
}
